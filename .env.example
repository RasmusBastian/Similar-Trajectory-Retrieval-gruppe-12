# Copy to .env to override the ports used by docker-compose.yml
DB_PORT=5433
API_PORT=5038
# Folder with the raw Rome data (matching_result.csv) for tsmini-import, relative to the repository root
ROME_MATCHING_DIR=../ST2Vec/data/rome/st_traj/st_traj
# Shared aSTEP database (astep-aau/data) for mapmatching and beijing-export, see README "Beijing data for TSMini and TrajCL"
SHARED_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5434/data
